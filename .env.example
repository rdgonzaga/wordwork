# Copy to .env.local. Both values come from Supabase > Project Settings > API.
# The anon key ships in the JS bundle by design; RLS is the protection.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Supabase user id that sees the Guide tab. Leave empty to hide it.
VITE_OWNER_ID=
